ARG BASE_IMAGE=debian:13-slim

FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        procps \
		locales \
        \
        build-essential \
        cmake \
        pkg-config \
		gettext \
        \
        libevent-dev \
        libssl-dev \
        libcurl4-gnutls-dev \
        libavutil-dev \
        libavformat-dev \
        libavcodec-dev \
        libavfilter-dev \
        libswresample-dev \
        libswscale-dev \
        libopenexr-dev \
        libopenimageio-dev \
        libgeographic.*-dev \
		libpango1.0-dev \
        libcairo2-dev \
		librsvg2-dev \
		\
		libfreetype-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean all

ADD docker/locale.gen /etc

RUN dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale 

